android_app {
    name: "LenovoParts",

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    sdk_version: "system_current",
    min_sdk_version: "30",
    vendor: true,
    privileged: true,

    static_libs: [
        "androidx.preference_preference",
        "SettingsLibCollapsingToolbarBaseActivity",
        "SettingsLibSettingsTheme",
    ],
}
