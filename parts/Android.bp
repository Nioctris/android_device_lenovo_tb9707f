android_app {
    name: "LenovoParts",

    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
    ],
    resource_dirs: ["res"],
    certificate: "platform",
    // KeyHandler implements com.android.internal.os.DeviceKeyHandler and is
    // loaded into system_server, so this needs platform APIs (not on vendor).
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },

    static_libs: [
        "pixel-power-ext-V2-java",
        "SpaLib",
        "androidx.compose.runtime_runtime",
        "kotlinx_coroutines_android",
    ],

    kotlincflags: ["-Xjvm-default=all"],
}
