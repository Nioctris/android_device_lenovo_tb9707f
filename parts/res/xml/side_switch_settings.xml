<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/side_switch_title">

    <ListPreference
        android:key="side_switch_action"
        android:title="@string/side_switch_action_title"
        android:entries="@array/side_switch_entries"
        android:entryValues="@array/side_switch_values"
        android:persistent="false"
        app:useSimpleSummaryProvider="true" />

    <Preference
        android:key="side_switch_hint"
        android:summary="@string/side_switch_hint"
        android:selectable="false" />
</PreferenceScreen>
