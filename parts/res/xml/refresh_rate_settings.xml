<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/refresh_rate_title">

    <ListPreference
        android:key="refresh_rate"
        android:title="@string/refresh_rate_fixed_title"
        android:entries="@array/refresh_rate_entries"
        android:entryValues="@array/refresh_rate_values"
        android:persistent="false"
        app:useSimpleSummaryProvider="true" />

    <SwitchPreferenceCompat
        android:key="adaptive_refresh_rate"
        android:title="@string/refresh_rate_adaptive_title"
        android:summary="@string/refresh_rate_adaptive_summary"
        android:persistent="false" />
</PreferenceScreen>
