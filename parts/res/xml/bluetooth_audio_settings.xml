<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/bt_audio_title">

    <org.lineageos.lenovoparts.widget.CardGridPreference
        android:key="bt_dashboard" />

    <PreferenceCategory
        android:key="bt_codec_category"
        android:title="@string/bt_codec_category">

        <org.lineageos.lenovoparts.widget.CodecListPreference
            android:key="bt_codec_list" />

        <ListPreference
            android:key="ldac_quality"
            android:title="@string/ldac_quality_title"
            android:entries="@array/ldac_quality_entries"
            android:entryValues="@array/ldac_quality_values"
            android:persistent="false" />
    </PreferenceCategory>


    <PreferenceCategory
        android:key="bt_sbc_category"
        android:title="@string/bt_sbc_category">

        <SwitchPreferenceCompat
            android:key="sbc_xq"
            android:title="@string/sbc_xq_title"
            android:summary="@string/sbc_xq_summary"
            android:persistent="false" />

        <ListPreference
            android:key="sbc_xq_bitrate"
            android:title="@string/sbc_xq_bitrate_title"
            android:entries="@array/sbc_xq_bitrate_entries"
            android:entryValues="@array/sbc_xq_bitrate_values"
            android:persistent="false" />

        <Preference
            android:key="sbc_xq_hint"
            android:summary="@string/sbc_xq_hint"
            android:selectable="false" />
    </PreferenceCategory>

    <Preference
        android:key="bt_profile_hint"
        android:selectable="false" />
</PreferenceScreen>
