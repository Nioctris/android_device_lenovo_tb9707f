<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <GridLayout
        android:id="@+id/cards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2" />

    <LinearLayout
        android:id="@+id/graph_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:visibility="gone"
        android:background="@drawable/card_background"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/power_graph_title"
            android:textColor="@color/card_label"
            android:textSize="13sp" />

        <org.lineageos.lenovoparts.widget.PowerGraphView
            android:id="@+id/power_graph"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/load_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:visibility="gone"
        android:background="@drawable/card_background"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/load_graph_title"
            android:textColor="@color/card_label"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/load_legend_cpu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/legend_cpu"
                android:drawablePadding="6dp"
                android:text="@string/load_cpu"
                android:textColor="@color/card_label"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/load_legend_gpu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:drawableStart="@drawable/legend_gpu"
                android:drawablePadding="6dp"
                android:text="@string/load_gpu"
                android:textColor="@color/card_label"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/load_legend_ram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:drawableStart="@drawable/legend_ram"
                android:drawablePadding="6dp"
                android:text="@string/load_ram"
                android:textColor="@color/card_label"
                android:textSize="13sp" />
        </LinearLayout>

        <org.lineageos.lenovoparts.widget.LoadGraphView
            android:id="@+id/load_graph"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</LinearLayout>
