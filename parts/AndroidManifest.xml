<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.lenovoparts"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.SubSettingsBase">

        <activity
            android:name=".display.RefreshRateActivity"
            android:exported="true"
            android:label="@string/refresh_rate_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.display" />
        </activity>

        <activity
            android:name=".sideswitch.SideSwitchActivity"
            android:exported="true"
            android:label="@string/side_switch_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
        </activity>

        <receiver
            android:name=".BootCompletedReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".perf.PerfProfileActivity"
            android:exported="true"
            android:label="@string/perf_profile_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.battery" />
        </activity>

        <activity
            android:name=".bypass.BypassChargingActivity"
            android:exported="true"
            android:label="@string/bypass_charging_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.battery" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/bypass_charging_summary" />
        </activity>

        <service
            android:name=".tiles.BypassChargingTileService"
            android:exported="true"
            android:icon="@drawable/ic_bypass_charging"
            android:label="@string/bypass_charging_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <service
            android:name=".tiles.PerfProfileTileService"
            android:exported="true"
            android:icon="@drawable/ic_perf_profile"
            android:label="@string/perf_profile_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
