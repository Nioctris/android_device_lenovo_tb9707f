+static bool IsY700SplitPanel(const drmModeConnector& connector, const drmModeModeInfo& mode) {
+  return connector.connector_type == DRM_MODE_CONNECTOR_DSI && mode.hdisplay == 1600 &&
+         mode.vdisplay == 2560 && android::base::GetProperty("ro.product.device", "") == "tb9707f";
+}
+
+static uint32_t FindDrmProperty(int fd, uint32_t object, uint32_t type, const char* name,
+                                uint64_t* value = nullptr) {
+  std::unique_ptr<drmModeObjectProperties, decltype(&drmModeFreeObjectProperties)> props(
+      drmModeObjectGetProperties(fd, object, type), drmModeFreeObjectProperties);
+  if (!props) return 0;
+  for (uint32_t i = 0; i < props->count_props; ++i) {
+    std::unique_ptr<drmModePropertyRes, decltype(&drmModeFreeProperty)> prop(
+        drmModeGetProperty(fd, props->props[i]), drmModeFreeProperty);
+    if (prop && strcmp(prop->name, name) == 0) {
+      if (value) *value = props->prop_values[i];
+      return prop->prop_id;
+    }
+  }
+  return 0;
+}
+
+struct MinuiBackendDrm::SplitScanout {
+  SplitScanout(int fd, uint32_t connector, uint32_t crtc)
+      : fd(fd), connector(connector), crtc(crtc) {}
+
+  ~SplitScanout() {
+    if (mode_blob) drmModeDestroyPropertyBlob(fd, mode_blob);
+  }
+
+  bool Init(const drmModeRes& resources, const drmModeModeInfo& mode) {
+    if (drmSetClientCap(fd, DRM_CLIENT_CAP_ATOMIC, 1) != 0 ||
+        drmModeCreatePropertyBlob(fd, &mode, sizeof(mode), &mode_blob) != 0) {
+      return false;
+    }
+
+    const auto crtc_index = std::find(resources.crtcs, resources.crtcs + resources.count_crtcs, crtc) -
+                            resources.crtcs;
+    if (crtc_index == resources.count_crtcs || crtc_index >= 32) return false;
+    std::unique_ptr<drmModePlaneRes, decltype(&drmModeFreePlaneResources)> planes(
+        drmModeGetPlaneResources(fd), drmModeFreePlaneResources);
+    if (!planes) return false;
+
+    connector_crtc = FindDrmProperty(fd, connector, DRM_MODE_OBJECT_CONNECTOR, "CRTC_ID");
+    crtc_mode = FindDrmProperty(fd, crtc, DRM_MODE_OBJECT_CRTC, "MODE_ID");
+    crtc_active = FindDrmProperty(fd, crtc, DRM_MODE_OBJECT_CRTC, "ACTIVE");
+    if (!connector_crtc || !crtc_mode || !crtc_active) return false;
+
+    // Y700's first two primary planes use separate pipes and support source split.
+    size_t found = 0;
+    for (uint32_t i = 0; i < planes->count_planes && found < 2; ++i) {
+      std::unique_ptr<drmModePlane, decltype(&drmModeFreePlane)> plane(
+          drmModeGetPlane(fd, planes->planes[i]), drmModeFreePlane);
+      if (!plane || !(plane->possible_crtcs & (1u << crtc_index)) ||
+          (plane->crtc_id && plane->crtc_id != crtc)) {
+        continue;
+      }
+      uint64_t type;
+      if (!FindDrmProperty(fd, plane->plane_id, DRM_MODE_OBJECT_PLANE, "type", &type) ||
+          type != DRM_PLANE_TYPE_PRIMARY ||
+          std::find(plane->formats, plane->formats + plane->count_formats, DRM_FORMAT_XBGR8888) ==
+              plane->formats + plane->count_formats) {
+        continue;
+      }
+      plane_ids[found++] = plane->plane_id;
+    }
+    if (found != 2) return false;
+
+    for (size_t i = 0; i < 2; ++i) {
+      for (size_t j = 0; j < arraysize(kPlaneProperties); ++j) {
+        plane_props[i][j] =
+            FindDrmProperty(fd, plane_ids[i], DRM_MODE_OBJECT_PLANE, kPlaneProperties[j]);
+        if (!plane_props[i][j]) return false;
+      }
+      for (auto& surface : halves[i]) {
+        surface = GRSurfaceDrm::Create(fd, mode.hdisplay / 2, mode.vdisplay);
+        if (!surface) return false;
+      }
+    }
+    return true;
+  }
+
+  bool Commit(int buffer, GRSurfaceDrm* source, bool modeset) {
+    std::unique_ptr<drmModeAtomicReq, decltype(&drmModeAtomicFree)> req(drmModeAtomicAlloc(),
+                                                                      drmModeAtomicFree);
+    if (!req) return false;
+    const bool enabled = source != nullptr;
+    auto add = [&](uint32_t object, uint32_t property, uint64_t value) {
+      return drmModeAtomicAddProperty(req.get(), object, property, value) >= 0;
+    };
+    if (modeset && (!add(connector, connector_crtc, enabled ? crtc : 0) ||
+                    !add(crtc, crtc_mode, enabled ? mode_blob : 0) ||
+                    !add(crtc, crtc_active, enabled))) {
+      return false;
+    }
+
+    for (size_t i = 0; i < 2; ++i) {
+      auto& half = halves[i][buffer];
+      if (enabled) {
+        // Keep minui's full-size drawing buffer and scan out with a half-width pitch.
+        const size_t bytes = half->width * half->pixel_bytes;
+        for (size_t row = 0; row < half->height; ++row) {
+          memcpy(half->data() + row * half->row_bytes,
+                 source->data() + row * source->row_bytes + i * bytes, bytes);
+        }
+      }
+      const uint64_t values[] = {
+        enabled ? half->fb_id : 0, enabled ? crtc : 0,
+        0, 0, half->width << 16, half->height << 16,
+        i * half->width, 0, half->width, half->height,
+      };
+      // Page flips update both framebuffer IDs in the same commit.
+      const size_t count = !modeset ? 1 : enabled ? arraysize(kPlaneProperties) : 2;
+      for (size_t j = 0; j < count; ++j) {
+        if (!add(plane_ids[i], plane_props[i][j], values[j])) return false;
+      }
+    }
+
+    if (drmModeAtomicCommit(fd, req.get(), modeset ? DRM_MODE_ATOMIC_ALLOW_MODESET : 0, nullptr) !=
+        0) {
+      perror("Failed to commit Y700 split scanout");
+      return false;
+    }
+    return true;
+  }
+
+  static constexpr const char* kPlaneProperties[] = {
+    "FB_ID", "CRTC_ID", "SRC_X", "SRC_Y", "SRC_W", "SRC_H", "CRTC_X", "CRTC_Y", "CRTC_W", "CRTC_H",
+  };
+  const int fd;
+  const uint32_t connector;
+  const uint32_t crtc;
+  uint32_t mode_blob = 0;
+  uint32_t connector_crtc = 0;
+  uint32_t crtc_mode = 0;
+  uint32_t crtc_active = 0;
+  uint32_t plane_ids[2]{};
+  uint32_t plane_props[2][arraysize(kPlaneProperties)]{};
+  std::unique_ptr<GRSurfaceDrm> halves[2][2];
+};
