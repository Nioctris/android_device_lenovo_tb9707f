on early-init
    mkdir /mnt/vendor/persist 0771 system system

on post-fs-data
    chown system system /sys/class/backlight/ktz8866-backlight/brightness
    chmod 0664 /sys/class/backlight/ktz8866-backlight/brightness

    # Lineage health charging control stops battery charging with the input
    # kept up, so the charger powers the device (bypass).
    chown system system /sys/class/power_supply/battery/battery_charging_enabled
    chmod 0664 /sys/class/power_supply/battery/battery_charging_enabled

on boot
    # The KTZ8866 is the only panel backlight; the stock ABL leaves a low
    # level in the chip. Use a readable level until the lights HAL takes over.
    write /sys/class/backlight/ktz8866-backlight/brightness 128

on property:sys.boot_completed=1
    # Let libperfmgr start applying power hints (boosts, profiles).
    setprop vendor.powerhal.init 1
